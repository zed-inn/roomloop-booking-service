# ==============================================================================
# RoomLoop Booking Service — Environment Variables Configuration Template
# Copy this file to 'config/.env' and adjust values as needed.
# ==============================================================================

# Network host interface to bind the REST service (default: localhost)
HOST="localhost"

# Network port for the REST service (default: 8095)
PORT=8095

# Runtime environment mode: 'development', 'production', or 'test' (default: development)
ENVIRONMENT="development"

# Logging verbosity level: 'DEBUG', 'INFO', 'WARNING', or 'ERROR' (default: INFO)
LOG_LEVEL="INFO"

# SQLite database file path (default: database.db)
DATABASE_FILE_PATH="database.db"
